{
  "id": "/",
  "name": "Kadam — documents, sheets, slides and plans",
  "short_name": "Kadam",
  "description": "Notes, sheets, slides, boards, deadlines and vocabulary practice. Everything you write, in one place, on every device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#16130f",
  "theme_color": "#faf7f2",
  "lang": "en",
  "dir": "ltr",
  "categories": ["education", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "./icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    {
      "name": "New note",
      "short_name": "Notes",
      "url": "./#/notes",
      "icons": [{ "src": "./shortcut-notes.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Deadlines",
      "short_name": "Tasks",
      "url": "./#/tasks",
      "icons": [{ "src": "./shortcut-tasks.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Draw a board",
      "short_name": "Canvas",
      "url": "./#/canvas",
      "icons": [{ "src": "./shortcut-canvas.png", "sizes": "96x96", "type": "image/png" }]
    }
  ]
}
