# Firebase web config — copy this file to `.env` and fill in your project's values.
#
# Find them in the Firebase console:
#   Project settings → General → Your apps → SDK setup and configuration → Config
#
# These are NOT secrets. A Firebase web config is meant to be public; access is
# controlled by Firestore security rules and Google sign-in, not by hiding these.
# The Anthropic API key is a real secret and never goes here — it lives in
# Firebase Secret Manager (see FIREBASE_SETUP.md).
#
# Vite only exposes variables prefixed with VITE_ to the browser.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Region the Cloud Function is deployed to. Leave as-is unless you changed it.
VITE_FIREBASE_REGION=us-central1
