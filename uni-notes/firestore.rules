rules_version = '2';

// Uni — Firestore security rules.
//
// Two shapes of data:
//
//   docs/{docId}          Shareable documents (notes, sheets, slide decks,
//                         canvas boards, task plans, vocab decks).
//                         Readable and writable by the accounts listed in
//                         memberUids. Editors may change content; viewers may
//                         only read. Membership itself is writable only by the
//                         owner — and in practice only through the sharing
//                         Cloud Functions, which is the only way to turn an
//                         email address into a uid.
//
//   users/{uid}/…         Personal: folders and preferences. Only that
//                         account, ever.
//
//   invites/{inviteId}    Written by the sharing functions. Deliberately
//                         unreadable and unwritable by clients: the invitee
//                         claims theirs through claimInvites(), which runs with
//                         admin privileges. Nothing here needs client access,
//                         so nothing gets it.
//
//   joinCodes/{code}      Invite links. The document id *is* the secret, so it
//                         is fetchable by anyone signed in who already has it
//                         and listable by nobody. See "invite links" below —
//                         this is the half of sharing that needs no server, and
//                         so no billing.
//
// Deploy with:  firebase deploy --only firestore:rules
// Check changes in the Console's Rules Playground before trusting them.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // --- shareable documents -------------------------------------------------

    function isMember() {
      return signedIn()
        && resource.data.memberUids is list
        && request.auth.uid in resource.data.memberUids;
    }

    function myRole() {
      return resource.data.roles is map
        ? resource.data.roles.get(request.auth.uid, '')
        : '';
    }

    function isDocOwner() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Membership fields are the access-control list, so only the owner may
    // change them. Anyone else editing must leave them exactly as they were.
    // The invite-link fields belong to that list: an editor who could rewrite
    // joinRole could quietly promote every future joiner to editor.
    function membershipUnchanged() {
      return request.resource.data.memberUids == resource.data.memberUids
        && request.resource.data.roles == resource.data.roles
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.get('joinCode', '') == resource.data.get('joinCode', '')
        && request.resource.data.get('joinRole', '') == resource.data.get('joinRole', '')
        && request.resource.data.get('joinExpiresAt', 0) == resource.data.get('joinExpiresAt', 0);
    }

    // --- invitations by email ------------------------------------------------
    //
    // The obvious way to invite someone by address needs a server: an email is
    // not an account id, and only the Admin SDK can turn one into the other.
    // That means Cloud Functions, which means a billing plan, for a feature two
    // cousins sharing an essay should not have to pay for.
    //
    // So the direction is reversed. The owner does not add the person; the
    // owner leaves an invitation, and the person picks it up. What makes that
    // safe is that Firebase has already checked the address: `token.email` on a
    // signed-in account is verified by Google, not typed in by the holder, and
    // `email_verified` is required below so that registering an address you do
    // not own is not a way in.
    //
    // An invitation is one string, `role:email`, so the role cannot be
    // separated from the person it was granted to. Claiming it consumes it.
    function myEmail() {
      return request.auth.token.get('email', '').lower();
    }

    function emailProven() {
      return signedIn()
        && myEmail() != ''
        && request.auth.token.get('email_verified', false) == true;
    }

    // Enough to *see* the document you were invited to, at either role, which
    // is what lets the app find it without being told where to look.
    function isInvited() {
      return emailProven()
        && resource.data.get('invitedEmails', []).hasAny([
             'editor:' + myEmail(),
             'viewer:' + myEmail(),
           ]);
    }

    function isAcceptingInvite() {
      return emailProven()
        && !(request.auth.uid in resource.data.memberUids)
        // The role taken must be the role offered, to this address.
        && resource.data.get('invitedEmails', []).hasAny(
             [request.resource.data.roles[request.auth.uid] + ':' + myEmail()])
        && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
        && request.resource.data.roles.diff(resource.data.roles).affectedKeys()
             == [request.auth.uid].toSet()
        && request.resource.data.members.diff(resource.data.members).affectedKeys()
             == [request.auth.uid].toSet()
        // Used up, so the same invitation cannot be claimed twice or left
        // lying around after the person has joined.
        && request.resource.data.invitedEmails == resource.data.invitedEmails
             .removeAll([request.resource.data.roles[request.auth.uid] + ':' + myEmail()])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberUids', 'roles', 'members', 'invitedEmails', 'updatedAt']);
    }

    // --- invite links --------------------------------------------------------
    //
    // Someone opening an invite link is, by definition, not yet a member: they
    // cannot read the document, so they cannot be asked to prove anything about
    // its contents. What they *can* do is present the code.
    //
    // The proof is the comparison below. The joiner writes the code they were
    // given into their own member entry, and the rule checks it against the
    // code stored on the document. Client-supplied data is measured against
    // server-held data, which is the only shape of check that means anything
    // here. Guessing is the alternative, and the codes are 26 random characters
    // from a 32-symbol alphabet — about 130 bits.
    //
    // Everything else is a containment check: they may add themselves and
    // nobody else, at the role the owner chose and no other, and they may not
    // touch a single other field on the way past.

    function linkIsLive() {
      return resource.data.get('joinExpiresAt', 0) == 0
        || request.time.toMillis() < resource.data.joinExpiresAt;
    }

    function isJoiningWithCode() {
      return signedIn()
        && resource.data.get('joinCode', '').size() >= 20
        && linkIsLive()
        // The code, as presented by the joiner, against the code we hold.
        && request.resource.data.members[request.auth.uid].via == resource.data.get('joinCode', '')
        && !(request.auth.uid in resource.data.memberUids)
        && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
        && request.resource.data.roles[request.auth.uid] == resource.data.get('joinRole', '')
        && request.resource.data.roles.diff(resource.data.roles).affectedKeys()
             == [request.auth.uid].toSet()
        && request.resource.data.members.diff(resource.data.members).affectedKeys()
             == [request.auth.uid].toSet()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberUids', 'roles', 'members', 'updatedAt']);
    }

    // A member removing only themselves — "leave a shared document".
    function isLeaving() {
      return signedIn()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && !(request.auth.uid in request.resource.data.memberUids)
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
        && resource.data.memberUids.hasAll(request.resource.data.memberUids);
    }

    // Cheap guards against a runaway client filling the database. Firestore
    // caps documents at 1 MiB regardless; these keep common fields sensible.
    function isSaneDocument() {
      return request.resource.data.keys().size() < 60
        && (!('title' in request.resource.data)
            || (request.resource.data.title is string
                && request.resource.data.title.size() <= 300))
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string
                && request.resource.data.name.size() <= 300));
    }

    match /docs/{docId} {
      allow read: if isMember() || isInvited();

      // A new document must be created owned by, and containing only, its author.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && isSaneDocument();

      // Owners may change anything. Editors may change content but not who has
      // access. Any member may remove themselves. Viewers may not write.
      allow update: if isSaneDocument() && (
        isDocOwner()
        || (isMember() && myRole() == 'editor' && membershipUnchanged())
        || (isMember() && isLeaving())
        || isJoiningWithCode()
        || isAcceptingInvite()
      );

      allow delete: if isDocOwner();

      // --- who is looking at this document right now ------------------------
      //
      // One row per account, named by uid, holding a display name and the time
      // of its last heartbeat. Anyone who can read the document can see who
      // else is in it; nobody can write a row but their own, so presence
      // cannot be faked for someone else.
      //
      // The membership test has to re-read the parent, because a subcollection
      // does not inherit its parent's data. That is one extra document read per
      // rule evaluation, which is the price of not putting a list of names
      // inside the document itself where every editor could rewrite it.
      match /presence/{personUid} {
        function parentMember() {
          return signedIn()
            && request.auth.uid in
                 get(/databases/$(database)/documents/docs/$(docId)).data.memberUids;
        }

        allow read: if parentMember();
        allow write: if parentMember()
          && request.auth.uid == personUid
          && (request.method == 'delete' || (
               request.resource.data.keys().hasOnly(['name', 'at'])
               && request.resource.data.at is int
               && request.resource.data.name is string
               && request.resource.data.name.size() <= 120
             ));
      }
    }

    // --- personal data -------------------------------------------------------

    // users/{uid}/folders/{id} and users/{uid}/meta/prefs
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{collection}/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isSaneDocument();
        allow delete: if isOwner(uid);
      }
    }

    // --- invitations ---------------------------------------------------------

    // Server-only. Clients go through the sharing Cloud Functions.
    match /invites/{inviteId} {
      allow read, write: if false;
    }

    // --- invite links --------------------------------------------------------
    //
    // A pointer from a code to the document it opens. The document id is the
    // secret, which is why `get` is open to any signed-in account and `list` is
    // open to none: knowing the code is the whole credential, and a listable
    // collection would hand out every code in the project.
    //
    // Deleting the pointer is how a link is revoked, so only its owner may.

    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && code.size() >= 20
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.docId is string
        && get(/databases/$(database)/documents/docs/$(request.resource.data.docId))
             .data.ownerUid == request.auth.uid;

      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Anything not matched above is denied by default.
    // Do not add a catch-all rule below this line.
  }
}
